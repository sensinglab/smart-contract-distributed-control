# Algorand node (local to Building A)
ALGOD_ADDRESS=http://127.0.0.1:8080
ALGOD_TOKEN=

# Building A controller account
# Never commit a real mnemonic.
CONTROLLER_MNEMONIC=
CONTROLLER_ADDRESS=
BUILDING_ID=A

# Building B public controller address
PEER_CONTROLLER=

# Reserved by the current implementation; the watcher reads algod directly.
USE_INDEXER=false

# Local openHAB REST endpoint and synchronization item
OPENHAB_BASE=https://127.0.0.1:8444
OPENHAB_SYNC_ITEM=IoT_SyncTrigger

# Local Bridge API
BRIDGE_HTTP_PORT=8787
ANNOUNCE_AMOUNT_MICROALGO=1000

# Non-authoritative local cache files
STATE_DB=/opt/iot-bridge/data/state.json
LAST_ROUND_FILE=/opt/iot-bridge/data/last_round
